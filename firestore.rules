/**
 * @file Firebase Security Rules for the Mindwell application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, where each user has exclusive access to their profile data, chat sessions, messages, sentiment analysis, voice blobs, and recommendations.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, ensuring a clear hierarchical structure. Chat sessions, messages, sentiment analysis, voice blobs, and recommendations are all subcollections of a specific user's document.
 *
 * Key Security Decisions:
 * - Users can only access their own data.
 * - Listing of user documents is disallowed to protect user privacy.
 *
 * Denormalization for Authorization:
 * N/A: This ruleset relies solely on path-based ownership.
 *
 * Structural Segregation:
 * The application leverages structural segregation by storing all user-private data under the /users/{userId} path, which enables secure and efficient enforcement of user-specific access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles, allowing access only to the owner.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, update, delete) User with matching UID can access and modify their profile.
     * @deny (create, get, update, delete) Any other user cannot access or modify another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure chat sessions, allowing access only to the owner.
     * @path /users/{userId}/chatSessions/{chatSessionId}
     * @allow (create, get, update, delete) User with matching UID can access and modify their chat sessions.
     * @deny (create, get, update, delete) Any other user cannot access or modify another user's chat sessions.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/chatSessions/{chatSessionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure chat messages, allowing access only to the owner.
     * @path /users/{userId}/chatSessions/{chatSessionId}/chatMessages/{chatMessageId}
     * @allow (create, get, update, delete) User with matching UID can access and modify their chat messages.
     * @deny (create, get, update, delete) Any other user cannot access or modify another user's chat messages.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/chatSessions/{chatSessionId}/chatMessages/{chatMessageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure sentiment analysis data, allowing access only to the owner.
     * @path /users/{userId}/chatSessions/{chatSessionId}/chatMessages/{chatMessageId}/sentimentAnalysis/{sentimentAnalysisId}
     * @allow (create, get, update, delete) User with matching UID can access and modify their sentiment analysis data.
     * @deny (create, get, update, delete) Any other user cannot access or modify another user's sentiment analysis data.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/chatSessions/{chatSessionId}/chatMessages/{chatMessageId}/sentimentAnalysis/{sentimentAnalysisId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure voice blobs, allowing access only to the owner.
     * @path /users/{userId}/voiceBlobs/{voiceBlobId}
     * @allow (create, get, update, delete) User with matching UID can access and modify their voice blobs.
     * @deny (create, get, update, delete) Any other user cannot access or modify another user's voice blobs.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/voiceBlobs/{voiceBlobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure recommendations, allowing access only to the owner.
     * @path /users/{userId}/recommendations/{recommendationId}
     * @allow (create, get, update, delete) User with matching UID can access and modify their recommendations.
     * @deny (create, get, update, delete) Any other user cannot access or modify another user's recommendations.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/recommendations/{recommendationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}
