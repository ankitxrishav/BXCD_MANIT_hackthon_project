rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/chatSessions/{sessionId} {
      allow list, read, write: if isOwner(userId);
    }

    match /users/{userId}/chatSessions/{sessionId}/messages/{messageId} {
      allow read, write: if isOwner(userId);
    }
    
    // This rule allows the collectionGroup query for 'messages' needed by the mood timeline.
    // It ensures a user can only 'list' messages where their UID matches the message's userId.
    match /{path=**}/messages/{messageId} {
      allow list: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /users/{userId}/moodTimeline/{dayId} {
      allow list, read, write: if isOwner(userId);
    }

    match /users/{userId}/recommendations/{recId} {
      allow list, read, write: if isOwner(userId);
    }
  }
}
