rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/chatSessions/{sessionId} {
      allow list, read, write: if isOwner(userId);
    }

    match /users/{userId}/chatSessions/{sessionId}/messages/{messageId} {
      allow list, read, write: if isOwner(userId);
    }

    match /users/{userId}/moodTimeline/{dayId} {
      allow list, read, write: if isOwner(userId);
    }

    match /users/{userId}/recommendations/{recId} {
      allow list, read, write: if isOwner(userId);
    }
  }
}
