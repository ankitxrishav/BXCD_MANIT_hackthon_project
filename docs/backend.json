{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user's profile information.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier from Firebase Auth."
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "displayName": {
          "type": "string"
        },
        "photoURL": {
          "type": "string",
          "format": "uri"
        },
        "settings": {
          "type": "object",
          "properties": {
            "enableSentimentAnalysis": { "type": "boolean" },
            "dataRetentionPeriod": { "type": "string" }
          }
        }
      },
      "required": ["uid", "email"]
    },
    "ChatSession": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ChatSession",
      "type": "object",
      "description": "Metadata for a single chat session.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ChatMessage",
      "type": "object",
      "description": "A single message within a chat session.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "sentiment": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "emotion": { "type": "string" }
          }
        }
      },
      "required": ["id", "userId", "role", "text", "timestamp"]
    },
    "MoodTimelineEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MoodTimelineEntry",
      "type": "object",
      "description": "An entry for the user's mood timeline.",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "score": { "type": "number" },
        "emotion": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "score", "emotion", "timestamp"]
    },
    "Recommendation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Recommendation",
      "type": "object",
      "description": "A personalized wellness recommendation.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "text", "timestamp"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Stores user profile data. Accessible only by the owning user."
        }
      },
      {
        "path": "/users/{userId}/chatSessions/{sessionId}",
        "definition": {
          "entityName": "ChatSession",
          "schema": { "$ref": "#/backend/entities/ChatSession" },
          "description": "Subcollection for a user's chat sessions."
        }
      },
      {
        "path": "/users/{userId}/chatSessions/{sessionId}/messages/{messageId}",
        "definition": {
          "entityName": "ChatMessage",
          "schema": { "$ref": "#/backend/entities/ChatMessage" },
          "description": "Subcollection for messages within a chat session."
        }
      },
      {
        "path": "/users/{userId}/moodTimeline/{dayId}",
        "definition": {
          "entityName": "MoodTimelineEntry",
          "schema": { "$ref": "#/backend/entities/MoodTimelineEntry" },
          "description": "Subcollection for daily mood timeline entries."
        }
      },
      {
        "path": "/users/{userId}/recommendations/{recId}",
        "definition": {
          "entityName": "Recommendation",
          "schema": { "$ref": "#/backend/entities/Recommendation" },
          "description": "Subcollection for personalized recommendations."
        }
      }
    ],
    "reasoning": "The Firestore structure is designed with subcollections to ensure scalability and adhere to Firestore's data modeling best practices. Each user has their own document, and related data like chat sessions, messages, and mood entries are stored in separate subcollections under that user. This approach prevents single-document size limits, allows for efficient querying of related data, and simplifies security rules by relying on path-based ownership."
  }
}
